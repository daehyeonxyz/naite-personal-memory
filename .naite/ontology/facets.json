{
  "schema_version": 2,
  "description": "Machine-readable facet definitions. Single source of the enum VALUES for the lint validator and naite-app filter UI. Note: lint consumes only each facet's `values` list; which facets are REQUIRED is owned by lint-ontology.py (its common_required list), not by the `required` flags here. v2: kind values carry a core flag — core kinds are harness-known (workflows depend on their semantics) and fixed; user kinds are vault-declared and get default page behavior. Enum changes to core kinds remain C-level (user decision) per CLAUDE.md Schema discipline; user kinds are added by declaring them here.",
  "facets": {
    "kind": {
      "multiple": false,
      "required": true,
      "search": "exact",
      "values": [
        { "value": "concept", "core": true },
        { "value": "entity", "core": true },
        { "value": "source-record", "core": true },
        { "value": "decision", "core": true },
        { "value": "project", "core": false },
        { "value": "insight", "core": false },
        { "value": "comparison", "core": false },
        { "value": "essay", "core": false },
        { "value": "personal", "core": false }
      ]
    },
    "form": {
      "multiple": false,
      "required": true,
      "search": "exact",
      "values": ["prose", "index"]
    },
    "source-types": {
      "multiple": true,
      "required": true,
      "search": "exact",
      "values": [
        "course",
        "conversation",
        "paper",
        "article",
        "docs",
        "book",
        "essay",
        "external"
      ]
    },
    "subject": {
      "multiple": true,
      "required": true,
      "search": "path",
      "canonical": "subject-tree.md"
    },
    "topics": {
      "multiple": true,
      "required": false,
      "search": "token",
      "canonical": "topics.md"
    },
    "created": {
      "multiple": false,
      "required": true,
      "search": "date"
    },
    "updated": {
      "multiple": false,
      "required": true,
      "search": "date"
    },
    "domains": {
      "multiple": true,
      "required": false,
      "cached": true,
      "search": "token"
    }
  }
}
