#!/bin/sh
# naite-personal-memory — pre-commit guard.
#
# Runs in two contexts. It ALWAYS blocks: USER.md / MEMORY.md / denylist.local
# (per-clone private state), a secret (API key / token / private key — common
# shapes only), a generic credential assignment (a PASSWORD or SECRET set to a
# value), a Windows reserved device-name slug, and any string in the local-only
# denylist. ADDITIONALLY, in the PUBLIC starter (detected via the
# .naite/PUBLIC_STARTER sentinel, or NAITE_HOOK_MODE=starter), it blocks personal
# vault content (tree/ pages, roots/ sources) and per-vault generated files.
#
# Mode precedence: NAITE_HOOK_MODE (starter|vault) > .naite/PUBLIC_STARTER sentinel
# > vault. See _naite_guard.sh and .naite/hooks/README.md.
#
# The secret scan is a best-effort allowlist and is NOT exhaustive. A companion
# pre-push hook re-runs these scans on the push range, catching commits made by
# merge / rebase / cherry-pick (which skip pre-commit) before they reach a remote.
#
# Activate (per clone, one time):   git config core.hooksPath .naite/hooks
#   NOTE: setting core.hooksPath makes git ignore .git/hooks/ entirely, so any
#   hook you rely on (e.g. a post-commit auto-push) must live under .naite/hooks/.
# Intentional override (rare):       git commit --no-verify

. "$(git rev-parse --show-toplevel)/.naite/hooks/_naite_guard.sh"

fail=0
err() { printf '  - %s\n' "$1" >&2; fail=1; }

starter=$(naite_starter_mode)

# --diff-filter=d = everything EXCEPT deletions, so renames/copies are checked at
# their destination path. core.quotePath=false keeps non-ASCII names literal.
staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=d)
deleted=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=D)
# --no-textconv so a .gitattributes diff driver cannot hide a secret from the scan.
diff=$(git diff --cached --no-textconv -U0)

naite_scan_paths "$staged" "$deleted" "$starter"
naite_scan_content "$diff"
naite_email_check

if [ "$fail" -eq 0 ]; then
  exit 0
fi

printf '\nnaite guard: commit blocked. See .naite/hooks/README.md.\n' >&2
printf 'If this is genuinely safe, re-run with:  git commit --no-verify\n' >&2
exit 1
