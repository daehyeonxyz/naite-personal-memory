# Secrets and private material — never commit
roots/private/
*.env
*.env.*
.envrc
credentials.json
secrets.json
*.pem
*.key
*_rsa
*_dsa
*_ed25519

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/

# Obsidian — per-machine UI state. Keep community-plugins.json, core-plugins.json,
# app.json, appearance.json, and per-plugin data.json tracked (config).
# Ignore plugin code (re-downloadable) and themes.
.obsidian/app.json
.obsidian/workspace*
.obsidian/cache
.obsidian/hotkeys.json
.obsidian/graph.json
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css
.obsidian/plugins/*/manifest.json
.obsidian/plugins/*/cache/
.obsidian/themes/

# Claude Code local state (if any leaks in — skills themselves ARE committed)
.claude/local/
.claude/settings.local.json
.claude/worktrees/

# Python — bytecode + install artifacts
__pycache__/
*.pyc
*.pyo
Python/
python_install_*.log

# Binaries — raw PDFs stay local only (CLAUDE.md § Binary files: < 1MB recommended;
# lecture PDFs under roots/courses/{slug}/ are not tracked — GitHub 50MB limit, no LFS yet).
# Small finished PDFs can be force-tracked explicitly with git add -f.
*.pdf

# Rendered article/deck images stay local; track extracted text/markdown instead.
roots/articles/**/*-png/

# Agent / IDE / package-manager scratch (see care-check.md § 7 Non-tree scratch dirt).
# .codex-work/ itself can be an intentional sub-project workspace, so it is not
# blocked wholesale — only node_modules inside it is.
**/node_modules/
.codex-cache/
.aider/
.cursor/
.windsurfai/

# Operational scratch — disposable tree maintenance artifacts (run logs, working files).
# Used by grow-backfill.md / care.md. Not for commit.
tmp/

# /naite care sweep runs — raw verdicts ignored, summary + cascade tracked.
# Pattern: .naite/reports/{date}-care/raw/ ignored; .lock and .phase1-complete ignored;
# summary.md + cascade *.jsonl + cache-state.json tracked.
.naite/reports/*-care/raw/
.naite/reports/*-care/.lock
.naite/reports/*-care/.phase1-complete
.naite/reports/*-care/chunks/
.naite/reports/*-care/chunk-results/
.naite/reports/*-care/chunk-summaries/

# Generated manifests are large daily files (~1MB+) — avoid commit churn
.naite/reports/*-care/manifest.jsonl

# Forest layer — generated/personal products (regenerated per vault; not committed).
# forest-config.example.json IS tracked; the real config and generated outputs are not.
.naite/forest/forest-config.json
.naite/forest/dashboard.md
.naite/ontology/forest-manifest.json

# Pre-commit guard's local-only personal denylist (never committed).
.naite/hooks/denylist.local

# Internal dev/planning artifacts — local-only. Specs and implementation plans
# (superpowers brainstorming/writing-plans output) are dev process docs, not
# product content. Keeping them untracked stops them shipping into user vaults
# on install (the install copies all non-.git files) and out of harness-lock.
docs/superpowers/

.gstack/
